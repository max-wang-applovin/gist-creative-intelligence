# Meta Marketing API (read-only insights)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Adjust Report Service (read-only)
# App token/name optional — discovered from the API token when omitted.
ADJUST_API_TOKEN=
ADJUST_APP_TOKEN=
ADJUST_APP_NAME=

# Read-only AdManage/AdScan key for public competitor creative discovery
ADMANAGE_API_KEY=

# Optional AI creative scans (manual Scan/Rescan button)
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
CREATIVE_SCAN_AUTO=true
CREATIVE_SCAN_DAILY_LIMIT=500
CREATIVE_SCAN_HOUR_UTC=7
CREATIVE_SCAN_DAYS=30
CREATIVE_SCAN_FORCE_DAILY=false
CREATIVE_SCAN_CONCURRENCY=2

# Shared dashboard access (required when NODE_ENV=production or on Render)
DASHBOARD_USERNAME=
# Use a unique password with at least 12 characters.
DASHBOARD_PASSWORD=
# Render injects PORT automatically. Set this only for a custom local port.
DASHBOARD_PORT=4173
# Mount a Render persistent disk here (recommended hosted value: /var/data).
DASHBOARD_DATA_DIR=.agent-serve

# Slack Socket Mode (from `npx @cursor/bdk slack create --dir . --name "Creative Intelligence"`)
CREATIVE_INTELLIGENCE_SLACK_BOT_TOKEN=
CREATIVE_INTELLIGENCE_SLACK_APP_TOKEN=
