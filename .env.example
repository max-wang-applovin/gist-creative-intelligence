# Copy to .env.local. Never commit real values. Never paste tokens in chat.

# Meta Marketing API system user token (ads_read / ads_management). Read-only dashboard.
META_ACCESS_TOKEN=

# Adjust Reporting API bearer token (same as Cathy's gist-ua ADJUST_API_TOKEN).
ADJUST_API_TOKEN=

# Optional overrides (defaults match Gist production account).
META_AD_ACCOUNT_ID=act_990337856783605
ADJUST_APP_NAME=Gist

# Set to 1 to force mock data even when tokens exist.
GCI_FORCE_MOCK=0
